[color]
    ui = true
    status = auto
    branch = auto
    interactive = auto
    diff = auto
[color "diff-highlight"]
    oldNormal = red bold
    oldHighlight = red bold 52
    newNormal = green bold
    newHighlight = green bold 22
[color "diff"]
    meta = 11
    frag = magenta bold
    func = 146 bold
    commit = yellow bold
    old = red bold
    new = green bold
    whitespace = red reverse
[core]
    editor = vim
    autocrlf = input
    pager = delta
[merge]
    tool = vimdiff
    conflictStyle = zdiff3
[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    df = diff
    list = ls-tree --full-tree -r HEAD
    unstage = reset HEAD --
    last = log -1 HEAD
    amend = commit --amend -C HEAD
[push]
    default = simple
[interactive]
    diffFilter = delta --color-only
[filter "lfs"]
	  smudge = git-lfs smudge -- %f
	  process = git-lfs filter-process
	  required = true
	  clean = git-lfs clean -- %f
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    true-color = always
